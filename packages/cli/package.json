{
  "name": "skill-lock",
  "version": "0.1.0",
  "description": "A lockfile for agent skills: pin every SKILL.md folder by content hash, fail CI when one changes, and scan skills for remote code, secrets, suspicious hosts and hidden Unicode.",
  "keywords": [
    "agent-skills",
    "skills",
    "claude",
    "claude-code",
    "lockfile",
    "supply-chain",
    "security",
    "scanner",
    "github-action",
    "cli"
  ],
  "license": "MIT",
  "author": "Bellhassen Sehli (https://github.com/Blhasn-Sehli)",
  "homepage": "https://github.com/Blhasn-Sehli/skill-lock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blhasn-Sehli/skill-lock.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Blhasn-Sehli/skill-lock/issues",
  "type": "module",
  "bin": {
    "skill-lock": "dist/skill-lock.js"
  },
  "files": [
    "dist/skill-lock.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node bundle.mjs",
    "prepack": "node bundle.mjs"
  },
  "devDependencies": {
    "@skill-lock/core": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
